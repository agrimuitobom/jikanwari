rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // subjects, teachers, assignments: 開発中は全許可（本番では認証チェックを追加すること）
    match /subjects/{docId} {
      allow read, write: if true;
    }
    match /teachers/{docId} {
      allow read, write: if true;
    }
    match /assignments/{docId} {
      allow read, write: if true;
    }
  }
}
